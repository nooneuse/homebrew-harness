{
  "prompt": "阅读项目的主要模块，将简短说明写入 REPORT.md，并读回确认。",
  "goal": {
    "condition": "项目说明已保存",
    "predicates": [
      {
        "id": "report",
        "type": "file_exists",
        "path": "REPORT.md",
        "min_bytes": 1
      }
    ],
    "judge": false
  },
  "total_seconds": 10800,
  "episode_seconds": 1500,
  "episode_model_calls": 20,
  "request_seconds": 500,
  "retries": 3,
  "context_chars": 100000,
  "output_tokens": 20000,
  "allow_tests": []
}
