# Copy this template to a private file outside the repository.
# All three values are required. No provider-specific defaults are built in.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional independent Goal checker model; blank reuses OPENAI_MODEL.
GOAL_EVALUATOR_MODEL=

# Optional model runtime limits; blank uses the documented defaults.
HARNESS_MODEL_CONCURRENCY=
HARNESS_MODEL_REQUEST_TIMEOUT=
# Optional total session seconds, including idle time; blank disables this total limit.
HARNESS_MODEL_SESSION_TIMEOUT=

# Optional host capability revision; changing it invalidates Workflow cache identity.
HARNESS_MODEL_PROFILE=
# Optional worker output/reasoning allowance (128..32768; default 4096).
HARNESS_WORKER_OUTPUT_TOKENS=
# Optional Memory selector output allowance (128..8192; default 2048).
HARNESS_MEMORY_SELECTION_TOKENS=

# Host module defaults; optional features are disabled in core.
HARNESS_PROFILE=core
# off, recall, or auto; automatic maintenance requires auto.
HARNESS_MEMORY_MODE=off
